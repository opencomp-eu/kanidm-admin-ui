# Kanidm server URL (must be reachable from this container)
KANIDM_URL=https://kanidm.example.com:8443

# Service account API token (generate in Kanidm, never expose to browser)
KANIDM_API_TOKEN=your_service_account_api_token_here

# External URL where this admin UI is accessible (for OIDC callback)
EXTERNAL_URL=http://localhost:8080

# Server listen address
LISTEN_ADDR=0.0.0.0:8080

# Cookie encryption secret (base64-encoded 32 bytes; generate a random one)
COOKIE_SECRET=changeme_generate_a_random_secret

# --- Optional: OIDC Configuration ---
# If unset, the app runs in dev mode with a simple login bypass.
# For production, configure all three:
# OIDC_ISSUER_URL=https://kanidm.example.com:8443/oauth2/openid/
# OIDC_CLIENT_ID=kanidm_admin_ui
# OIDC_CLIENT_SECRET=your_oauth2_client_secret
